# Port (auto-set by Render — do not modify)
PORT=10000

# Your owner WhatsApp number (without the +)
OWNER_NUMBER=224610835573

# Optional: external URL of your Render service (auto-provided by Render)
# RENDER_EXTERNAL_URL=https://varnox-xd-v2.onrender.com

# Optional: Command prefix (default: .)
# PREFIX=.

# Optional: Bot name
# BOT_NAME=VARNOX XD V2

# Optional: Chatbot API
# CHATBOT_API_URL=https://zellapi.autos/ai/chatbot
# CHATBOT_API_KEY=

# Required only for .tg / .stickertelegram
# TELEGRAM_BOT_TOKEN=123456:replace_with_your_token

# ── Link with the VARNOX site (varnox-x-ultra-pair) ───────────────────────────
# Without DATABASE_URL, the bridge stays inactive and the bot works exactly
# as before. With it, the site shows this server online, distributes the
# pairing codes requested from the web page, and lists paired sessions.

# Site database (the same as its DATABASE_URL on Vercel).
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Optional: completely disable the bridge
# SITE_BRIDGE=off

# Optional: which server slot this bot represents (1, 2 or 3)
# SITE_SERVER_ID=1
# SITE_SERVER_NAME=Server 1

# Optional: where to reach this bot's /code route (default: 127.0.0.1:$PORT)
# SITE_BOT_URL=http://127.0.0.1:10000

# Optional: intervals (ms)
# SITE_HEARTBEAT_MS=45000
# SITE_POLL_MS=5000
# SITE_SESSIONS_MS=30000
