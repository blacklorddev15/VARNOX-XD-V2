# Port (auto-set by Render — ne pas modifier)
PORT=10000

# Ton numéro WhatsApp propriétaire (sans le +)
OWNER_NUMBER=224610835573

# Optionnel : URL externe de ton service Render (auto-fourni par Render)
# RENDER_EXTERNAL_URL=https://varnox-xd-v2.onrender.com

# Optionnel : Préfixe des commandes (défaut : .)
# PREFIX=.

# Optionnel : Nom du bot
# BOT_NAME=VARNOX XD V2

# Optionnel : API du chatbot
# CHATBOT_API_URL=https://zellapi.autos/ai/chatbot
# CHATBOT_API_KEY=

# Requis uniquement pour .tg / .stickertelegram
# TELEGRAM_BOT_TOKEN=123456:replace_with_your_token

# ── Liaison avec le site VARNOX (varnox-x-ultra-pair) ─────────────────────────
# Sans DATABASE_URL, le bridge reste inactif et le bot fonctionne exactement
# comme avant. Avec, le site affiche ce serveur en ligne, distribue les codes
# de jumelage demandés depuis la page web, et liste les sessions appairées.

# Base de données du site (la même que son DATABASE_URL sur Vercel).
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Optionnel : désactiver complètement la liaison
# SITE_BRIDGE=off

# Optionnel : quel emplacement serveur ce bot représente (1, 2 ou 3)
# SITE_SERVER_ID=1
# SITE_SERVER_NAME=Server 1

# Optionnel : où joindre la route /code de ce bot (défaut : 127.0.0.1:$PORT)
# SITE_BOT_URL=http://127.0.0.1:10000

# Optionnel : cadences (ms)
# SITE_HEARTBEAT_MS=45000
# SITE_POLL_MS=5000
# SITE_SESSIONS_MS=30000
